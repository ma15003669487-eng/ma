# 必填
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_or_channel_id

# 如需自动交易必须填写
PRIVATE_KEY=
CHAIN_ID=137

# 可选：数据源与执行模式
POLYMARKET_API=https://gamma-api.polymarket.com
AUTO_TRADE=false

# 可选：阈值、步长、下单金额
ARBITRAGE_THRESHOLD=0.99
ARBITRAGE_STEP=0.01
QUOTE_SIZE=20
QUOTE_STEP=5

# 可选：风险参数
TAKER_FEE_BPS=25
GAS_FEE_USD=0.05
MIN_BALANCE_BUFFER=5
AUTO_SETTLE=false
